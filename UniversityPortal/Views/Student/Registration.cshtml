@model List<UniversityPortal.Models.Entities.Course>

<h2>Course Registration</h2>

<div class="row">
    @foreach (var course in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@course.CourseName (@course.CourseCode)</h5>
                    <p class="card-text">Professor: @course.Professor.Name</p>
                    <p class="card-text">Credits: @course.CreditHours</p>

                    <form asp-action="Register" method="post">
                        <input type="hidden" name="courseId" value="@course.Id" />
                        <input type="hidden" name="studentId" value="PASTE_A_STUDENT_GUID_FROM_DB_HERE" />
                        <button type="submit" class="btn btn-primary">Enroll Now</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>